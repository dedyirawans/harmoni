{
  "name": "WhatsApp -> Safar CRM (Log Percakapan)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wa-incoming",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Webhook (Pesan WA Masuk)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "wa-incoming"
    },
    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\n// ====== EDIT BAGIAN INI ======\nconst CRM_API_URL='https://crm-access-control-3.preview.emergentagent.com';\nconst API_KEY='PASTE_API_KEY_ANDA';\nconst API_SECRET='PASTE_API_SECRET_ANDA';\n// =============================\nconst inc=$json.body||$json;\nconst from=inc.from||inc.whatsapp||inc.phone||'';\nconst text=inc.text||inc.message||'';\nconst idem=(inc.message_id||(Date.now()+'-'+from)).toString();\nconst payload={whatsapp:from,channel:'WHATSAPP',direction:'INBOUND',message:text,message_type:'TEXT',sender_type:'CUSTOMER',external_message_id:idem};\nconst bodyStr=JSON.stringify(payload);\nconst ts=Math.floor(Date.now()/1000).toString();\nconst signature=crypto.createHmac('sha256',API_SECRET).update(ts+'.'+bodyStr).digest('hex');\nreturn [{json:{url:CRM_API_URL+'/api/v1/conversations',bodyStr,apiKey:API_KEY,ts,signature,idem}}];"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Buat Signature HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-API-Key", "value": "={{ $json.apiKey }}" },
            { "name": "X-Timestamp", "value": "={{ $json.ts }}" },
            { "name": "X-Signature", "value": "={{ $json.signature }}" },
            { "name": "X-Idempotency-Key", "value": "={{ $json.idem }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.bodyStr }}",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Kirim ke CRM (/api/v1/conversations)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 300]
    }
  ],
